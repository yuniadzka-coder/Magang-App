rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /places/{placeId} {
      allow read, write: if isValidId(placeId);
    }

    match /journals/{journalId} {
      allow read, write: if isValidId(journalId);
    }

    match /attendance/{attendanceId} {
      allow read, write: if isValidId(attendanceId);
    }

    match /targets/{targetId} {
      allow read, write: if isValidId(targetId);
    }

    match /documentations/{docId} {
      allow read, write: if isValidId(docId);
    }

    match /announcements/{announcementId} {
      allow read, write: if isValidId(announcementId);
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
